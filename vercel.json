{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "src": "^/archivio/?$", "dest": "/archivio/index.html" },
    { "src": "^/privacy/?$", "dest": "/privacy/index.html" },
    { "src": "^/geometra/cantieri/?$", "dest": "/geometra/cantieri/index.html" },
    { "src": "^/fotografia/(primi-piani|sala-posa|in-esterna|bianco-e-nero|paesaggi)/?$", "dest": "/fotografia/$1/index.html" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
